    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate by status class",
      "datasource": {
        "type": "prometheus",
        "uid": "digiscript-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "digiscript-prometheus"
          },
          "expr": "sum by (status) (rate(tornado_http_requests_total{handler!=\"WebSocketController\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "description": "HTTP requests per second by status class. WebSocket upgrades (101) are excluded."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request latency p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "digiscript-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 9
