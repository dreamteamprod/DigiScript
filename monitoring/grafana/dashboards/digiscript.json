      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "digiscript-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(tornado_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "digiscript-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tornado_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
